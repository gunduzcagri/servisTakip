generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  TECHNICIAN
  CUSTOMER
  CASHIER
}

enum ServiceStatus {
  RECEIVED
  INSPECTING
  PRICE_OFFER
  APPROVED
  CANCELLED
  PARTS_WAITING
  REPAIRING
  QC
  READY
  DELIVERED
}

enum PhotoType {
  BEFORE
  DURING
  AFTER
}

enum NotificationChannel {
  SMS
  EMAIL
  PUSH
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum NotificationTrigger {
  RECEIVED
  INSPECTING
  PRICE_OFFER
  APPROVED
  PARTS_WAITING
  REPAIRING
  QC
  READY
  DELIVERED
  CANCELLED
}

model Branch {
  id            String          @id @default(uuid())
  name          String
  address       String?
  phone         String?
  isHeadquarters Boolean        @default(false)
  users         User[]
  serviceRecords ServiceRecord[]
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  @@map("branches")
}

model User {
  id            String          @id @default(uuid())
  email         String          @unique
  passwordHash  String          @map("password_hash")
  fullName      String          @map("full_name")
  phone         String?
  role          UserRole        @default(CUSTOMER)
  branchId      String?         @map("branch_id")
  branch        Branch?         @relation(fields: [branchId], references: [id])
  isActive      Boolean         @default(true) @map("is_active")
  customerRecords ServiceRecord[] @relation("Customer")
  technicianRecords ServiceRecord[] @relation("Technician")
  statusLogs    StatusLog[]
  notifications Notification[]
  createdTemplates SectorTemplate[] @relation("TemplateCreator")
  devices        Device[]       @relation("DeviceCustomer")
  invoices       Invoice[]      @relation("InvoiceCustomer")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  @@map("users")
}

model SectorTemplate {
  id        String              @id @default(uuid())
  name      String
  fields    Json
  isSystem  Boolean             @default(false) @map("is_system")
  createdBy String?             @map("created_by")
  creator   User?               @relation("TemplateCreator", fields: [createdBy], references: [id])
  devices   Device[]
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")

  @@map("sector_templates")
}

model Device {
  id            String          @id @default(uuid())
  customerId    String          @map("customer_id")
  customer      User            @relation("DeviceCustomer", fields: [customerId], references: [id])
  templateId    String          @map("template_id")
  template      SectorTemplate  @relation(fields: [templateId], references: [id])
  dynamicFields Json?           @map("dynamic_fields")
  qrCode        String?         @map("qr_code")
  barcode       String?
  serviceRecords ServiceRecord[]
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  @@map("devices")
}

model ServiceRecord {
  id               String         @id @default(uuid())
  trackingNumber   String         @unique @map("tracking_number")
  customerId       String         @map("customer_id")
  customer         User           @relation("Customer", fields: [customerId], references: [id])
  deviceId         String         @map("device_id")
  device           Device         @relation(fields: [deviceId], references: [id])
  technicianId     String?        @map("technician_id")
  technician       User?          @relation("Technician", fields: [technicianId], references: [id])
  branchId         String?        @map("branch_id")
  branch           Branch?        @relation(fields: [branchId], references: [id])
  status           ServiceStatus  @default(RECEIVED)
  faultDescription String?        @map("fault_description")
  estimatedCost    Float?        @map("estimated_cost")
  customerApproved Boolean        @default(false) @map("customer_approved")
  estimatedDelivery DateTime?     @map("estimated_delivery")
  deliveredAt      DateTime?      @map("delivered_at")
  statusLogs       StatusLog[]
  actions          ServiceAction[]
  serviceParts     ServicePart[]
  photos           ServicePhoto[]
  notifications    Notification[]
  ratings          CustomerRating[]
  invoice          Invoice?
  cargoShipment    CargoShipment?
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  @@index([customerId])
  @@index([technicianId])
  @@index([status])
  @@map("service_records")
}

model StatusLog {
  id              String         @id @default(uuid())
  serviceRecordId String         @map("service_record_id")
  serviceRecord   ServiceRecord  @relation(fields: [serviceRecordId], references: [id])
  status          ServiceStatus
  note            String?
  changedBy       String?        @map("changed_by")
  changedByUser   User?          @relation(fields: [changedBy], references: [id])
  createdAt       DateTime       @default(now()) @map("created_at")

  @@map("status_logs")
}

model ServiceAction {
  id              String         @id @default(uuid())
  serviceRecordId String         @map("service_record_id")
  serviceRecord   ServiceRecord  @relation(fields: [serviceRecordId], references: [id])
  description     String
  laborCost       Float?        @map("labor_cost")
  timeSpentMin    Int?           @map("time_spent_min")
  technicianId    String?        @map("technician_id")
  createdAt       DateTime       @default(now()) @map("created_at")

  @@map("service_actions")
}

model Part {
  id              String          @id @default(uuid())
  name            String
  sku             String          @unique
  description     String?
  unitPrice       Float           @map("unit_price")
  stockQuantity   Int             @default(0) @map("stock_quantity")
  criticalThreshold Int           @default(5) @map("critical_threshold")
  minStockLevel   Int             @default(10) @map("min_stock_level")
  maxStockLevel   Int?            @map("max_stock_level")
  supplierId      String?         @map("supplier_id")
  supplier        Supplier?       @relation(fields: [supplierId], references: [id])
  serviceParts    ServicePart[]
  stockMovements  StockMovement[]
  stockAlerts     StockAlert[]
  location        String?
  barcode         String?
  isActive        Boolean         @default(true) @map("is_active")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  @@index([sku])
  @@index([supplierId])
  @@map("parts")
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
  RETURN
}

model Supplier {
  id            String          @id @default(uuid())
  name          String
  contactName   String?         @map("contact_name")
  phone         String?
  email         String?
  address       String?
  taxNumber     String?         @map("tax_number")
  taxOffice     String?         @map("tax_office")
  isActive      Boolean         @default(true) @map("is_active")
  parts         Part[]
  purchaseOrders PurchaseOrder[]
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  @@map("suppliers")
}

model PurchaseOrder {
  id            String          @id @default(uuid())
  orderNumber   String          @unique @map("order_number")
  supplierId    String          @map("supplier_id")
  supplier      Supplier        @relation(fields: [supplierId], references: [id])
  status        String          @default("DRAFT") // DRAFT, SENT, RECEIVED, CANCELLED
  items         Json            // [{ partId, quantity, unitPrice }]
  totalAmount   Float           @map("total_amount")
  notes         String?
  expectedDate  DateTime?       @map("expected_date")
  receivedDate  DateTime?       @map("received_date")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  @@map("purchase_orders")
}

model StockMovement {
  id            String            @id @default(uuid())
  partId        String            @map("part_id")
  part          Part              @relation(fields: [partId], references: [id])
  type          StockMovementType
  quantity      Int
  previousStock Int               @map("previous_stock")
  newStock      Int               @map("new_stock")
  reason        String?
  referenceType String?           @map("reference_type") // SERVICE, PURCHASE_ORDER, etc.
  referenceId   String?           @map("reference_id")
  userId        String?           @map("user_id")
  createdAt     DateTime          @default(now()) @map("created_at")

  @@map("stock_movements")
}

model StockAlert {
  id            String          @id @default(uuid())
  partId        String          @map("part_id")
  part          Part            @relation(fields: [partId], references: [id])
  threshold     Int
  currentStock  Int             @map("current_stock")
  isResolved    Boolean         @default(false) @map("is_resolved")
  notifiedAt    DateTime?       @map("notified_at")
  resolvedAt    DateTime?       @map("resolved_at")
  createdAt     DateTime        @default(now()) @map("created_at")

  @@map("stock_alerts")
}

model ServicePart {
  id              String         @id @default(uuid())
  serviceRecordId String         @map("service_record_id")
  serviceRecord   ServiceRecord  @relation(fields: [serviceRecordId], references: [id])
  partId          String         @map("part_id")
  part            Part           @relation(fields: [partId], references: [id])
  quantity        Int            @default(1)
  unitPriceAtTime Float          @map("unit_price_at_time")
  createdAt       DateTime       @default(now()) @map("created_at")

  @@map("service_parts")
}

model ServicePhoto {
  id              String         @id @default(uuid())
  serviceRecordId String         @map("service_record_id")
  serviceRecord   ServiceRecord  @relation(fields: [serviceRecordId], references: [id])
  url             String
  type            PhotoType      @default(BEFORE)
  note            String?
  createdAt       DateTime       @default(now()) @map("created_at")

  @@map("service_photos")
}

model Notification {
  id              String              @id @default(uuid())
  userId          String              @map("user_id")
  user            User                @relation(fields: [userId], references: [id])
  serviceRecordId String              @map("service_record_id")
  serviceRecord   ServiceRecord       @relation(fields: [serviceRecordId], references: [id])
  channel         NotificationChannel
  trigger         NotificationTrigger
  content         String
  status          NotificationStatus  @default(PENDING)
  sentAt          DateTime?           @map("sent_at")
  errorMessage    String?             @map("error_message")
  createdAt       DateTime            @default(now()) @map("created_at")

  @@map("notifications")
}

model CustomerRating {
  id              String        @id @default(uuid())
  serviceRecordId String        @unique @map("service_record_id")
  serviceRecord   ServiceRecord @relation(fields: [serviceRecordId], references: [id])
  score           Int
  comment         String?
  createdAt       DateTime      @default(now()) @map("created_at")

  @@map("customer_ratings")
}

model SystemSetting {
  id    String @id @default(uuid())
  key   String @unique
  value String

  @@map("system_settings")
}

enum SmsProvider {
  NETGSM
  TWILIO
  BULKSMS
}

model SmsLog {
  id          String        @id @default(uuid())
  recipient   String        @map("recipient")
  message     String
  status      String        @default("PENDING") // PENDING, SENT, FAILED
  provider    SmsProvider?
  messageId   String?       @map("message_id")
  errorCode   String?       @map("error_code")
  errorMessage String?      @map("error_message")
  segments    Int           @default(1)
  cost        Float?
  referenceType String?     @map("reference_type") // SERVICE, QUOTE, etc.
  referenceId String?       @map("reference_id")
  createdAt   DateTime      @default(now()) @map("created_at")

  @@index([recipient])
  @@index([status])
  @@map("sms_logs")
}

model SmsProviderConfig {
  id        String       @id @default(uuid())
  name      String       @unique
  provider  SmsProvider
  isActive  Boolean      @default(false) @map("is_active")
  config    Json         // Provider-specific config (API key, SID, etc.)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  @@map("sms_provider_configs")
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum InvoiceType {
  SALES
  PURCHASE
  PROFORMA
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CREDIT_CARD
  DEBIT_CARD
  CHECK
  OTHER
}

model Account {
  id          String        @id @default(uuid())
  code        String        @unique
  name        String
  type        AccountType
  parentId    String?       @map("parent_id")
  parent      Account?      @relation("AccountHierarchy", fields: [parentId], references: [id])
  children    Account[]     @relation("AccountHierarchy")
  description String?
  isActive    Boolean       @default(true) @map("is_active")
  balance     Float         @default(0)
  transactions AccountTransaction[]
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@index([code])
  @@index([type])
  @@map("accounts")
}

model AccountTransaction {
  id          String      @id @default(uuid())
  accountId   String      @map("account_id")
  account     Account     @relation(fields: [accountId], references: [id])
  type        String      // DEBIT, CREDIT
  amount      Float
  description String
  referenceType String?   @map("reference_type") // INVOICE, PAYMENT, EXPENSE
  referenceId String?     @map("reference_id")
  date        DateTime    @default(now())
  createdAt   DateTime    @default(now()) @map("created_at")

  @@index([accountId])
  @@index([date])
  @@map("account_transactions")
}

model Invoice {
  id              String         @id @default(uuid())
  invoiceNumber   String         @unique @map("invoice_number")
  type            InvoiceType
  status          InvoiceStatus  @default(DRAFT)
  customerId      String?        @map("customer_id")
  customer        User?          @relation("InvoiceCustomer", fields: [customerId], references: [id])
  serviceRecordId String?        @unique @map("service_record_id")
  serviceRecord   ServiceRecord? @relation(fields: [serviceRecordId], references: [id])
  cargoShipment   CargoShipment?
  items           InvoiceItem[]
  subtotal        Float          @default(0)
  taxRate         Float          @default(18) // KDV oranı
  taxAmount       Float          @default(0)  @map("tax_amount")
  total           Float          @default(0)
  discount        Float          @default(0)
  notes           String?
  dueDate         DateTime?      @map("due_date")
  issueDate       DateTime       @default(now()) @map("issue_date")
  paidDate        DateTime?      @map("paid_date")
  payments        Payment[]
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  @@index([invoiceNumber])
  @@index([status])
  @@index([customerId])
  @@map("invoices")
}

model InvoiceItem {
  id          String      @id @default(uuid())
  invoiceId   String      @map("invoice_id")
  invoice     Invoice     @relation(fields: [invoiceId], references: [id])
  description String
  quantity    Int         @default(1)
  unitPrice   Float       @map("unit_price")
  totalPrice  Float       @map("total_price")
  taxRate     Float       @default(18)
  createdAt   DateTime    @default(now()) @map("created_at")

  @@map("invoice_items")
}

model Payment {
  id              String        @id @default(uuid())
  invoiceId       String        @map("invoice_id")
  invoice         Invoice       @relation(fields: [invoiceId], references: [id])
  amount          Float
  method          PaymentMethod @default(CASH)
  reference       String?       // Dekont no, check no, etc.
  notes           String?
  paymentDate     DateTime      @default(now()) @map("payment_date")
  createdAt       DateTime      @default(now()) @map("created_at")

  @@map("payments")
}

model Expense {
  id          String      @id @default(uuid())
  category    String
  description String
  amount      Float
  date        DateTime    @default(now())
  vendor      String?
  invoiceNo   String?     @map("invoice_no") // Gelen fatura no
  paymentMethod PaymentMethod @default(CASH) @map("payment_method")
  notes       String?
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  @@index([category])
  @@index([date])
  @@map("expenses")
}

enum CargoCompany {
  ARAS
  YURTICI
  MNG
  PTT
  SURAT
  UPS
  FEDEX
  DHL
  TRENDYOL
  HEPJET
}

enum CargoStatus {
  CREATED
  PICKED_UP
  IN_TRANSIT
  AT_DESTINATION
  DELIVERED
  RETURNED
  FAILED
}

model CargoShipment {
  id              String        @id @default(uuid())
  trackingNumber  String        @unique @map("tracking_number")
  company         CargoCompany
  status          CargoStatus   @default(CREATED)
  serviceRecordId String?       @unique @map("service_record_id")
  serviceRecord   ServiceRecord? @relation(fields: [serviceRecordId], references: [id])
  invoiceId       String?       @unique @map("invoice_id")
  invoice         Invoice?       @relation(fields: [invoiceId], references: [id])
  senderName      String        @map("sender_name")
  senderPhone     String        @map("sender_phone")
  senderAddress   String        @map("sender_address")
  senderCity      String        @map("sender_city")
  recipientName   String        @map("recipient_name")
  recipientPhone  String        @map("recipient_phone")
  recipientAddress String       @map("recipient_address")
  recipientCity   String        @map("recipient_city")
  packageCount    Int           @default(1) @map("package_count")
  weight          Float?
  dimensions      String?       // 30x40x50 gibi
  cargoCode       String?       @map("cargo_code") // Firma tarafindan verilen kod
  barcode         String?
  notes           String?
  price           Float?
  trackingHistory Json?         @map("tracking_history")
  deliveredAt     DateTime?     @map("delivered_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  @@index([trackingNumber])
  @@index([company])
  @@index([status])
  @@map("cargo_shipments")
}

model CargoConfig {
  id          String       @id @default(uuid())
  company     CargoCompany @unique
  isActive    Boolean      @default(false) @map("is_active")
  apiKey      String?      @map("api_key")
  apiSecret   String?      @map("api_secret")
  username    String?
  password    String?
  baseUrl     String?      @map("base_url")
  senderName  String?      @map("sender_name")
  senderPhone String?      @map("sender_phone")
  senderCity  String?      @map("sender_city")
  config      Json?        // Ek ayarlar
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@map("cargo_configs")
}
